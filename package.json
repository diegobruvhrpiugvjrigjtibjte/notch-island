{
  "name": "notch-island",
  "version": "3.1.1",
  "description": "Dynamic Island per Windows con assistente, Claude Code, VS Code e Chrome",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "test": "node test/brain.test.js && node test/executor.test.js && node test/calc.test.js && node test/voice.test.js && node test/hub.test.js",
    "docs:screenshots": "node scripts/make-screenshots.js docs/screenshots"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "local.notchisland",
    "productName": "NotchIsland",
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "artifactName": "NotchIsland-Setup-${version}.exe"
    },
    "files": [
      "src/**",
      "integrations/chrome/**",
      "integrations/vscode/*.vsix",
      "package.json",
      "!**/key.json"
    ],
    "asar": false
  },
  "license": "MIT",
  "author": "NotchIsland contributors",
  "keywords": [
    "dynamic-island",
    "windows",
    "electron",
    "claude-code",
    "voice-assistant",
    "vscode",
    "chrome-extension",
    "whisper",
    "widgets"
  ]
}