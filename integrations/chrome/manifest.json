{
  "manifest_version": 3,
  "name": "NotchIsland",
  "description": "Collega Chrome a NotchIsland: schede, media e comandi vocali.",
  "version": "1.0.0",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "NotchIsland",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icon128.png"
  }
}